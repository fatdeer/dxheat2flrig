{
  "name": "DXHeat 一键调频",
  "description": "在 DXHeat.com 上点击频率，一键控制 FLRig 调谐电台",
  "version": "1.4",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://dxheat.com/*"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "bg.js",
    "type": "module"
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "dxheat2flrig",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "manifest_version": 3
}
